# ==========================================
# Configuración de Entorno - Dulce Arte
# ==========================================

APP_NAME="Dulce Arte"
APP_ENV=development
APP_URL=http://localhost:8000

# Base de Datos (mysql con fallback automático a sqlite en desarrollo si mysql está detenido)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=dulce_arte_db
DB_USER=root
DB_PASS=

# Archivo SQLite para desarrollo rápido o contingencia
DB_SQLITE_PATH=database/dulce_arte.sqlite

# Configuración de Negocio y Envíos
WHATSAPP_NUMBER=5493804232210
MAX_DAILY_ORDERS=8
DELIVERY_HOURS="17:00 a 20:00 hs"
DELIVERY_DAYS="1,2,3,4,5,6"

# Redes Sociales
INSTAGRAM_USER=dulceartelr
FACEBOOK_USER=dulceartedulce
